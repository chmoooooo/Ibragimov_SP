class Games:
    def __init__(self, developer, year, genre, platform=None):
        self.developer = developer
        self.year = year
        self.genre = genre
        self.platform = platform
    
    def info(self):
        print(f"Разработчик: {self.developer}\n"
              f"Год выпуска: {self.year}\n"
              f"Жанр: {self.genre}")
        if self.platform:
            print(f"Платформа: {self.platform}")
    
    def is_mobile(self):
        return self.platform == "mobile"


class Clash_Royale(Games):
    def __init__(self, developer, year, genre, difficulty):
        super().__init__(developer, year, genre, platform="mobile")
        self.difficulty = difficulty
    
    def info(self):
        super().info()
        print(f"Сложность: {self.difficulty}")


class Bloodboorne(Games):
    def __init__(self, developer, year, genre, device):
        super().__init__(developer, year, genre, platform=device)
        self.device = device
    
    def info(self):
        super().info()
        print(f"Устройство: {self.device}")


# Создание объектов
clash_royale = Clash_Royale("Supercell", "2016", "RTS", "Hard") 
bloodboorne = Bloodboorne("FromSoftware", "2015", "Soulslike", "Console") 

# Вывод информации
clash_royale.info()
print("Мобильная игра?", clash_royale.is_mobile())
print()

bloodboorne.info()
print("Мобильная игра?", bloodboorne.is_mobile())





