class Games:
    def __init__(self, developer, year, genre):
        self.developer = developer
        self.year = int(year)
        self.genre = genre
    
    def info(self):
        print(f"Разработчик: {self.developer}\n"
              f"Год выпуска: {self.year}\n"
              f"Жанр: {self.genre}")
    
    def kogda_vishla_igra (self):
        current_year = 2026  
        age = current_year - self.year
        print(f"Игра вышла {age} лет назад")


class Clash_Royale(Games):
    def __init__(self, developer, year, genre, difficulty):
        super().__init__(developer, year, genre)
        self.difficulty = difficulty
    
    def info(self):
        super().info()
        print(f"Сложность: {self.difficulty}")


class Bloodboorne(Games):
    def __init__(self, developer, year, genre, device):
        super().__init__(developer, year, genre)
        self.device = device
    
    def info(self):
        super().info()
        print(f"Устройство: {self.device}")



clash_royale = Clash_Royale("Supercell", 2016, "RTS", "Средняя")
