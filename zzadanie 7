using System.Net.Http.Json;
using System.Text.Json;

class Program
{
    static HttpClient httpClient = new HttpClient();
    static string baseUrl = "https://localhost:7284";

    static async Task Main()
    {
        Console.WriteLine("Лабораторная работа\n");

        try
        {
            // 1. Получаем список пользователей
            List<Person>? users = await httpClient.GetFromJsonAsync<List<Person>>($"{baseUrl}/api/users");

            if (users == null)
            {
                Console.WriteLine("Не удалось получить список пользователей");
                return;
            }

            Console.WriteLine("1. Исходный список пользователей:");
            PrintUsers(users);

            // 2. Вывести предпоследний элемент и несколько элементов по выбору с помощью индекса
            Console.WriteLine("\n2. Элементы по индексам:");
            if (users.Count >= 2)
            {
                Console.WriteLine($"   - Предпоследний элемент: {users[users.Count - 2].Name} (Id: {users[users.Count - 2].Id})");
            }
            Console.WriteLine($"   - Элемент с индексом 2: {users[2].Name} (Id: {users[2].Id})");
            Console.WriteLine($"   - Элемент с индексом 5: {users[5].Name} (Id: {users[5].Id})");
            Console.WriteLine($"   - Элемент с индексом 7: {users[7].Name} (Id: {users[7].Id})");

            // 3. Изменить элемент в определенной позиции (индекс 3)
            Console.WriteLine("\n3. Изменение элемента на позиции 3 (индекс 3):");
            Console.WriteLine($"   - До изменения: {users[3].Name} (Id: {users[3].Id})");

            var updatedPerson = new Person { Id = users[3].Id, Name = "Michael" };
            using var putResponse = await httpClient.PutAsJsonAsync($"{baseUrl}/api/users", updatedPerson);

            if (putResponse.IsSuccessStatusCode)
            {
                Person? updated = await putResponse.Content.ReadFromJsonAsync<Person>();
                if (updated != null)
                {

                    users[3] = updated;
                    Console.WriteLine($"   - После изменения: {users[3].Name} (Id: {users[3].Id})");
                }
            }
            else
            {
                var error = await putResponse.Content.ReadFromJsonAsync<Error>();
                Console.WriteLine($"   - Ошибка: {error?.message}");
            }

            // 4. Вывести элементы в диапазоне
            Console.WriteLine("\n4. Элементы в диапазоне [2:6]:");
            for (int i = 2; i <= 6 && i < users.Count; i++)
            {
                Console.WriteLine($"   - {users[i].Name} (Id: {users[i].Id})");
            }

            // 5. Добавить элемент в конец списка
            Console.WriteLine("\n5. Добавление элемента в конец списка:");
            var newUser = new Person { Name = "William" };
            using var postResponse = await httpClient.PostAsJsonAsync($"{baseUrl}/api/users", newUser);
            Person? addedUser = await postResponse.Content.ReadFromJsonAsync<Person>();

            if (addedUser != null)
            {
                users.Add(addedUser);
                Console.WriteLine($"   Добавлен: {addedUser.Name} (Id: {addedUser.Id})");
            }

            // 6. Добавить элемент в середину списка
            Console.WriteLine("\n6. Добавление элемента в середину списка:");
            var midUser = new Person { Name = "Jessica" };
            using var postMidResponse = await httpClient.PostAsJsonAsync($"{baseUrl}/api/users", midUser);
            Person? addedMidUser = await postMidResponse.Content.ReadFromJsonAsync<Person>();

            if (addedMidUser != null)
            {
                int middleIndex = users.Count / 2;
                users.Insert(middleIndex, addedMidUser);
                Console.WriteLine($"   Вставлен: {addedMidUser.Name} (Id: {addedMidUser.Id}) на позицию {middleIndex}");
            }

            // 7. Подсчитать количество повторяющихся элементов
            Console.WriteLine("\n7. Подсчёт повторяющихся элементов:");
            var nameGroups = users.GroupBy(u => u.Name);
            Console.WriteLine("   Статистика по именам:");
            foreach (var group in nameGroups)
            {
                if (group.Count() > 1)
                {
                    Console.WriteLine($"   - '{group.Key}': {group.Count()} раза (повторяется)");
                }
                else
                {
                    Console.WriteLine($"   - '{group.Key}': {group.Count()} раз");
                }
            }

            // Считаем конкретные имена из задания
            int tomCount = users.Count(u => u.Name == "Tom");
            int bobCount = users.Count(u => u.Name == "Bob");
            Console.WriteLine($"\n   Подробнее:");
            Console.WriteLine($"   - Количество 'Tom': {tomCount}");
            Console.WriteLine($"   - Количество 'Bob': {bobCount}");

            // 8. Скопировать список
            Console.WriteLine("\n8. Копирование списка:");
            string json = JsonSerializer.Serialize(users);
            List<Person>? copiedUsers = JsonSerializer.Deserialize<List<Person>>(json);

            if (copiedUsers != null && copiedUsers.Any())
            {
                Console.WriteLine($"   Оригинал[0]: {users[0].Name} (Id: {users[0].Id})");
                Console.WriteLine($"   Копия[0]: {copiedUsers[0].Name} (Id: {copiedUsers[0].Id})");

                copiedUsers[0].Name = "CHANGED_NAME";

                Console.WriteLine($"\n   После изменения копии:");
                Console.WriteLine($"   Оригинал[0]: {users[0].Name} (Id: {users[0].Id})");
                Console.WriteLine($"   Копия[0]: {copiedUsers[0].Name} (Id: {copiedUsers[0].Id})");
                Console.WriteLine("   ✓ Копия не влияет на оригинал (глубокое копирование)");
            }

            // 9. Показать итоговый список
            Console.WriteLine("\n9. Итоговый список всех пользователей:");
            var finalUsers = await httpClient.GetFromJsonAsync<List<Person>>($"{baseUrl}/api/users");
            PrintUsers(finalUsers!);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ошибка: {ex.Message}");
            Console.WriteLine("Убедитесь, что сервер запущен и URL правильный!");
        }
    }

    static void PrintUsers(List<Person> users)
    {
        for (int i = 0; i < users.Count; i++)
        {
            Console.WriteLine($"   {i,2}: Id: {users[i].Id,-3} | Имя: {users[i].Name}");
        }
    }
}

public class Person
{
    public int Id { get; set; }
    public string Name { get; set; } = "";
}

public class Error
{
    public string message { get; set; } = "";
}
